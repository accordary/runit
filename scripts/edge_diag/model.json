{
  "name": "runit-edge-diag",
  "version": "1.0.0",
  "license": "See COPYING.md in the repository root; this model file is distributed under the same terms.",
  "kind": "linear-logistic",
  "classes": ["healthy", "respawn_loop", "dependency_stall", "permission_fault", "disk_pressure"],
  "features": ["exit_nonzero", "restart_rate", "log_err_rate", "log_perm_tokens", "log_disk_tokens", "log_dep_tokens", "uptime_short"],
  "weights": {
    "healthy":          [-2.0, -2.0, -2.0, -1.0, -1.0, -1.0, -2.0],
    "respawn_loop":     [ 1.2,  3.4,  0.6,  0.0,  0.0,  0.0,  2.6],
    "dependency_stall": [ 0.8,  0.3,  1.1,  0.0,  0.0,  3.5,  0.4],
    "permission_fault": [ 1.0,  0.2,  1.0,  3.8,  0.0,  0.0,  0.3],
    "disk_pressure":    [ 0.7,  0.2,  1.0,  0.0,  3.6,  0.0,  0.2]
  },
  "bias": {"healthy": 1.4, "respawn_loop": -1.0, "dependency_stall": -1.0, "permission_fault": -1.0, "disk_pressure": -1.0}
}
